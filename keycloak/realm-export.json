{
  "realm": "incert",
  "enabled": true,
  "displayName": "Incert OCSP Identity",
  "sslRequired": "NONE",
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN",
        "description": "Administrator role for Incert OCSP Console"
      },
      {
        "name": "ROLE_OPERATOR",
        "description": "Operator role for Incert OCSP Console"
      },
      {
        "name": "ROLE_AUDITOR",
        "description": "Auditor role for Incert OCSP Console"
      },
      {
        "name": "admin",
        "description": "Admin role"
      }
    ]
  },
  "groups": [
    {
      "name": "ocsp-administrators",
      "path": "/ocsp-administrators",
      "realmRoles": [
        "ROLE_ADMIN",
        "admin"
      ]
    },
    {
      "name": "ocsp-operators",
      "path": "/ocsp-operators",
      "realmRoles": [
        "ROLE_ADMIN",
        "ROLE_OPERATOR"
      ]
    },
    {
      "name": "ocsp-auditors",
      "path": "/ocsp-auditors",
      "realmRoles": [
        "ROLE_AUDITOR"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ocsp-console",
      "name": "Incert OCSP Console",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "group-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@incert.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Incert",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "groups": [
        "/ocsp-administrators"
      ],
      "realmRoles": [
        "ROLE_ADMIN",
        "admin"
      ]
    },
    {
      "username": "operator",
      "email": "operator@incert.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OCSP",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "groups": [
        "/ocsp-operators"
      ],
      "realmRoles": [
        "ROLE_ADMIN",
        "ROLE_OPERATOR"
      ]
    },
    {
      "username": "auditor",
      "email": "auditor@incert.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Security",
      "lastName": "Auditor",
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "groups": [
        "/ocsp-auditors"
      ],
      "realmRoles": [
        "ROLE_AUDITOR"
      ]
    }
  ]
}
