# ──────────────────────────────────────────────────────────────────────────────
# OCSP Console — environment variables
# Copy to .env.local for local dev (Vite reads .env.local automatically)
# In production these are injected at build time via CI/CD or docker-compose.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the ocsp-responder API (dev-proxy target)
VITE_API_BASE_URL=http://localhost:8080

# Base URL of the KMS Simulator (dev-proxy target)
VITE_KMS_BASE_URL=http://localhost:8090

# Base URL of the OCSP Client service (dev-proxy target)
VITE_CLIENT_BASE_URL=http://localhost:8082

# Optional: Keycloak auth server base URL (overrides server-side config)
# VITE_KEYCLOAK_URL=http://localhost:8081

# Portal links shown in the sidebar (defaults shown below — override for prod)
VITE_PORTAL_RESPONDER_SWAGGER=http://localhost:8080/swagger-ui/index.html
VITE_PORTAL_CLIENT_SWAGGER=http://localhost:8082/swagger-ui/index.html
VITE_PORTAL_KMS_SWAGGER=http://localhost:8090/swagger-ui/index.html
VITE_PORTAL_KMS_UI=http://localhost:8090
VITE_PORTAL_CLIENT_UI=http://localhost:8082
VITE_PORTAL_RABBITMQ=http://localhost:15672

