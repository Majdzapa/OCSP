# ============================================================
# OCSP Subsystem — .gitignore
# ============================================================

# Maven build output
target/
*.class
*.jar
!**/src/main/resources/*.jar

# IDE files
.idea/
*.iml
.vscode/
*.code-workspace
.DS_Store

# Spring Boot DevTools
spring-boot-devtools.properties

# Environment / secrets — NEVER commit production secrets
*.env
.env*
*.jks
*.p12
*.pem
*.key
*.crt

# Track dev/test certificates for RabbitMQ mTLS & docker compose
!certs/rabbitmq/*
!kms-simulator/src/main/resources/certs/**
!ocsp-responder/src/main/resources/certs/**
!data/pki/*.pem

# Node / React
ocsp-console/node_modules/
ocsp-console/dist/
ocsp-console/.oxlintrc.json
*.tsbuildinfo

# Docker volumes
mariadb-data/
data/pki/

# Logs
*.log
logs/
